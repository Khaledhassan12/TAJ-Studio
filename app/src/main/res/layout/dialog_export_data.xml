<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_convos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Conversations &amp; Messages" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_memories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Memories" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_prompts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="System Prompts" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Settings" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_secrets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="Credentials &amp; Secrets" />

</LinearLayout>
