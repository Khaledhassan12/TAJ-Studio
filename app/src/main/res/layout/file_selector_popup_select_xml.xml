<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingTop="48dp">

    <!-- Premium Segmented Selector (Fixed at Top) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selector_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/options_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            app:checkedButton="@id/option_view"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/option_view"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/common_word_view"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/option_custom_view"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/common_word_custom_view"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:alpha="0.8"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Content List (Properly Chained) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_xml"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/createNewView"
        android:layout_below="@id/selector_container"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="4"
        tools:listitem="@layout/file_selector_popup_select_xml_activity_item" />

    <!-- Floating Action Button (Fixed at Bottom) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/createNewView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="Create new view"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:cornerRadius="24dp"
        app:elevation="6dp"
        app:icon="@drawable/ic_add_white_24dp"
        app:iconTint="?attr/colorOnPrimaryContainer" />

</RelativeLayout>