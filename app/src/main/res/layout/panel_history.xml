<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface" android:padding="8dp">
 <com.google.android.material.card.MaterialCardView android:id="@+id/ai_history_header" android:layout_width="match_parent" android:layout_height="wrap_content"
  app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
     <TextView android:id="@+id/tv_history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_tab_history" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your conversations, ready to revisit or branch" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
    <com.google.android.material.chip.Chip android:id="@+id/ai_history_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 chats" app:chipBackgroundColor="?attr/colorSecondaryContainer" app:chipStrokeWidth="0dp"/>
   </LinearLayout>
   <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Search conversation history" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" app:startIconDrawable="@drawable/ic_mtrl_search" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_et_history_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:paddingTop="12dp" android:paddingBottom="12dp"/>
   </com.google.android.material.textfield.TextInputLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end|center_vertical" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton android:id="@+id/ai_btn_import_session" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import JSON" app:icon="@drawable/ic_mtrl_download" app:iconGravity="textStart"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/ai_btn_new_history_session" style="@style/Widget.Material3.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="New chat" app:icon="@drawable/ic_mtrl_add" app:iconGravity="textStart"/>
   </LinearLayout>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
 <TextView android:id="@+id/tv_history_section_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/ai_history_header" android:layout_marginStart="4dp" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:text="RECENT CONVERSATIONS" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/tv_history_section_label">
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/ai_rv_history" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp"/>
  <TextView android:id="@+id/ai_tv_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:text="No conversations yet. Start a chat or import a saved session." android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone"/>
 </FrameLayout>
 <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/ai_fab_new_session" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:src="@drawable/ic_mtrl_add" android:visibility="gone" app:fabSize="normal"/>
</RelativeLayout>