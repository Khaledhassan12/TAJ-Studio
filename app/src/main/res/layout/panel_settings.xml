<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_tab_settings"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_streaming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Token Streaming"
            android:checked="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_markdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Render Markdown"
            android:checked="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Auto-suggest Agent mode"
            android:checked="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_haptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Haptic Feedback"
            android:checked="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Temperature"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="1.0"
            android:stepSize="0.1"
            android:value="0.7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_diagnostics"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run diagnostics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_full_settings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Open full settings" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_readback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Config read-back (debug)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"/>
                <TextView
                    android:id="@+id/tv_readback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>