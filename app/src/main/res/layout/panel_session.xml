<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="?attr/colorSurface">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ai_header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_tag_assistant"
                    android:contentDescription="@string/ai_meet_assistant"
                    android:background="?attr/colorSecondaryContainer"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TAJ AI ASSISTANT"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your project-aware development partner"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:id="@+id/ai_connection_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/circle_dot" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/ai_chip_agent_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text=""
                    android:contentDescription="Switch between Agent and Chat mode"
                    app:chipIcon="@drawable/ic_taj_agent_mode"
                    app:chipIconVisible="true"
                    app:iconStartPadding="4dp"
                    app:iconEndPadding="4dp"
                    app:chipMinHeight="32dp"
                    app:ensureMinTouchTargetSize="true"
                    app:chipStrokeWidth="0dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <TextView
                    android:id="@+id/ai_tv_model_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="GPT-4o"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/ai_chip_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_badge_cloud"
                    app:chipMinHeight="24dp"
                    app:chipBackgroundColor="?attr/colorTertiaryContainer"
                    app:chipStrokeWidth="0dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.chip.Chip
        android:id="@+id/ai_chip_project_scope"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ai_header_card"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:text="Active project"
        android:clickable="false"
        android:focusable="false"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        app:chipMinHeight="24dp"
        app:chipStrokeWidth="0dp"
        app:chipBackgroundColor="?attr/colorSecondaryContainer"
        app:ensureMinTouchTargetSize="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_rv_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ai_input_container"
        android:layout_below="@id/ai_chip_project_scope"
        android:layout_marginTop="0dp"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="8dp" />

    <!-- Compact, transparent jump-to-latest control anchored above the composer at the end edge. -->
    <ImageButton
        android:id="@+id/ai_fab_scroll_bottom"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/ai_input_container"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_mtrl_arrow_down"
        android:contentDescription="Jump to latest message"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:elevation="2dp"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.Chip
        android:id="@+id/ai_chip_edit_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/ai_input_container"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:text="@string/ai_msg_edit_banner"
        android:visibility="gone"
        app:chipBackgroundColor="?attr/colorTertiaryContainer"
        app:chipIcon="@drawable/ic_mtrl_edit"
        app:chipIconTint="?attr/colorOnTertiaryContainer"
        app:closeIconVisible="true"
        app:closeIconTint="?attr/colorOnTertiaryContainer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ai_slash_suggestions_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/ai_input_container"
        android:layout_alignStart="@id/ai_input_card"
        android:layout_alignEnd="@id/ai_input_card"
        android:layout_marginBottom="8dp"
        android:elevation="10dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:fillViewport="false"
            android:scrollbars="vertical">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ai_slash_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:singleLine="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/ai_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ai_input_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginBottom="2dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <EditText
                android:id="@+id/ai_et_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/ai_ask_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ai_fab_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Send message"
            android:src="@drawable/ic_mtrl_send"
            app:fabSize="mini"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ai_input_container"
        android:layout_below="@id/ai_chip_project_scope"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:alpha="0.9"
                android:src="@drawable/ic_tag_assistant"
                android:contentDescription="@string/ai_meet_assistant" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ai_meet_assistant"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Ask, build, inspect, and improve your active Sketchware project."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ai_empty_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_suggestion_explain" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_suggestion_button" />

        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

</RelativeLayout>