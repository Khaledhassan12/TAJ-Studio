<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ai_header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/ai_chip_agent_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/ai_agent_off"
                app:chipMinHeight="32dp"
                app:chipStrokeWidth="0dp"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <View
                android:id="@+id/ai_connection_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_dot" />

            <TextView
                android:id="@+id/ai_tv_model_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GPT-4o"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ai_chip_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_badge_cloud"
                app:chipMinHeight="24dp"
                app:chipBackgroundColor="?attr/colorTertiaryContainer"
                app:chipStrokeWidth="0dp"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_rv_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ai_input_container"
        android:layout_below="@id/ai_header_card"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <com.google.android.material.chip.Chip
        android:id="@+id/ai_chip_edit_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/ai_input_container"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:text="@string/ai_msg_edit_banner"
        android:visibility="gone"
        app:chipBackgroundColor="?attr/colorTertiaryContainer"
        app:chipIcon="@drawable/ic_mtrl_edit"
        app:chipIconTint="?attr/colorOnTertiaryContainer"
        app:closeIconVisible="true"
        app:closeIconTint="?attr/colorOnTertiaryContainer" />

    <LinearLayout
        android:id="@+id/ai_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingTop="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <EditText
                android:id="@+id/ai_et_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/ai_ask_hint"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:padding="12dp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ai_fab_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mtrl_send"
            app:fabSize="normal"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ai_input_container"
        android:layout_below="@id/ai_header_card"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0.4"
            android:src="@drawable/ic_tag_assistant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ai_meet_assistant"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ai_empty_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_suggestion_explain" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_suggestion_button" />

        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

</RelativeLayout>