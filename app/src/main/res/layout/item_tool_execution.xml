<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="3dp"
    android:padding="9dp"
    android:background="?attr/colorSurfaceContainerLow">
    <LinearLayout
        android:id="@+id/ai_tool_card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/ai_tool_domain"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_domain_tag"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/ai_tool_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ai_tool_progress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            app:indicatorSize="16dp"
            app:trackThickness="2dp" />
        <ImageView
            android:id="@+id/ai_tool_status"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Tool status"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ai_tool_input_header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/colorSurfaceContainerHigh"
        android:paddingHorizontal="9dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JSON · INPUT"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="?attr/colorPrimary" />
        <TextView
            android:id="@+id/ai_tool_copy_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="COPY"
            android:textStyle="bold"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
    <TextView
        android:id="@+id/ai_tool_input_json"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="9dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:maxLines="10"
        android:ellipsize="end"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/ai_tool_output_header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/colorSurfaceContainerHigh"
        android:paddingHorizontal="9dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXECUTOR · OUTPUT"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="?attr/colorTertiary" />
        <TextView
            android:id="@+id/ai_tool_copy_output"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="COPY"
            android:textStyle="bold"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="?attr/colorTertiary" />
    </LinearLayout>
    <TextView
        android:id="@+id/ai_tool_output_json"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="9dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:maxLines="10"
        android:ellipsize="end"
        android:visibility="gone" />
    <TextView
        android:id="@+id/ai_tool_result_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:padding="3dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>