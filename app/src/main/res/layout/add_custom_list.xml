<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp">

    <!-- Type Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/typeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Type"
        app:boxBackgroundColor="?attr/colorSurfaceContainerLow"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="2dp"
        app:endIconDrawable="@android:drawable/ic_menu_edit"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorPrimary"
        app:startIconDrawable="@android:drawable/ic_dialog_info"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. ArrayList&lt;Data&gt;"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Name Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name"
        app:boxBackgroundColor="?attr/colorSurfaceContainerLow"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="2dp"
        app:endIconDrawable="@android:drawable/ic_menu_edit"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorPrimary"
        app:startIconDrawable="@android:drawable/ic_menu_mylocation"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. dataList"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>